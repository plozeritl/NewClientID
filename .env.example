# =============================================================================
# Alertes Stripe -> Telegram — variables d'environnement
# Copier ce fichier en .env et remplir. Le .env n'est jamais commité.
# =============================================================================

# --- OBLIGATOIRE -------------------------------------------------------------

# Signature des webhooks Stripe. Commence par whsec_.
# Où : Stripe > Développeurs > Webhooks > (votre endpoint) > "Révéler la clé secrète".
# En local avec `stripe listen`, c'est la clé affichée dans le terminal — ce n'est
# PAS la même que celle de l'endpoint du dashboard, ne pas les confondre.
STRIPE_WEBHOOK_SECRET=

# Jeton du bot Telegram, donné par @BotFather (ressemble à 123456:AAE...).
# C'est un secret : qui l'a peut écrire partout où le bot est présent.
TELEGRAM_BOT_TOKEN=

# Identifiant du groupe qui reçoit les alertes. Négatif pour un groupe
# (ex. -1001234567890). Pour le trouver : ajouter le bot au groupe, y écrire un
# message, puis lancer `python outils/trouver_chat_id.py`.
TELEGRAM_CHAT_ID=

# --- RECOMMANDÉ --------------------------------------------------------------

# Clé API Stripe RESTREINTE EN LECTURE (commence par rk_). Cinq permissions,
# toutes en "Read" : Customers, Products, Events, Balance transactions,
# Subscriptions.
#   - Customers et Products : afficher les noms plutôt que les identifiants ;
#   - Events : relire l'historique au démarrage pour que les compteurs ne partent
#     pas de zéro (voir RATTRAPAGE_JOURS). Sans elle, la pipeline alerte
#     normalement mais les totaux démarrent vides — /health le signale.
#   - Balance transactions : le volume net réellement encaissé, affiché dans les
#     récapitulatifs. Sans elle, ce chiffre disparaît simplement des messages.
#   - Subscriptions : le nombre d'abonnés actifs (2e ligne du bilan). Sans elle,
#     cette ligne disparaît simplement.
# Sans elle, les alertes affichent "cus_123" au lieu de "Marie Dupont — marie@ex.fr".
# Ne jamais mettre ici une clé secrète standard (sk_) : cette app n'a aucun besoin
# d'écrire dans Stripe.
STRIPE_API_KEY=

# --- FACULTATIF --------------------------------------------------------------

# Évènements écoutés. Ne pas modifier sans raison : les deux sont nécessaires pour
# n'alerter QUE sur les souscriptions réussies (voir README, section "Ce qui
# déclenche une alerte"). Aucune alerte n'est envoyée sur un échec de paiement ou
# une annulation.
STRIPE_EVENEMENTS=customer.subscription.created,customer.subscription.updated

# Heures (heure de Paris) des récapitulatifs postés sur Telegram.
# 0 = bilan de minuit : clôt la journée écoulée et ajoute les 7 derniers jours.
# Ajouter des heures (ex. 0,12,18) pour des points sur la journée en cours.
RECAP_HEURES=0

# "false" pour ne garder que les alertes de souscription, sans aucun récapitulatif.
RECAP_ACTIF=true

# Jours d'historique Stripe relus au démarrage pour remplir les compteurs, afin que
# les totaux ne partent pas de zéro le premier jour. 0 désactive.
RATTRAPAGE_JOURS=7

# Journal anti-doublon et compteurs. Sur Railway, faire pointer vers un volume persistant
# (ex. /data/alertes.db) pour qu'il survive aux redéploiements. C'est lui qui
# contient l'historique des souscriptions : SANS VOLUME, les totaux du jour et de
# la semaine repartent de zéro à chaque redéploiement.
DB_PATH=
